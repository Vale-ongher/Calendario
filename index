<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Il Calendario degli indizi</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Nunito:wght@500;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --sky-top:#0a3a8c;
  --sky-mid:#1d6fd6;
  --sky-low:#78bdf7;
  --ink:#ffffff;
  --glass:rgba(255,255,255,.14);
  --glass-line:rgba(255,255,255,.38);
  --gold:#ffd34d;
  --card:#fffaf1;
  --card-ink:#1b2a4a;
  --card-soft:#5a6b8c;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --sky-top:#04173f; --sky-mid:#0c3d8c; --sky-low:#3a7cd0;
    --card:#14213d; --card-ink:#f2f5ff; --card-soft:#aebbd8;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --sky-top:#04173f; --sky-mid:#0c3d8c; --sky-low:#3a7cd0;
  --card:#14213d; --card-ink:#f2f5ff; --card-soft:#aebbd8;
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{
  margin:0;min-height:100%;
  background:var(--sky-top);
  color:var(--ink);
  font-family:"Nunito","Trebuchet MS",system-ui,sans-serif;
  -webkit-font-smoothing:antialiased;
}
.sky{position:fixed;inset:0;z-index:0;background:linear-gradient(180deg,var(--sky-top) 0%,var(--sky-mid) 55%,var(--sky-low) 100%)}
#snow{position:fixed;inset:0;z-index:1;pointer-events:none}
.page{position:relative;z-index:2;max-width:960px;margin:0 auto;padding:clamp(20px,5vw,48px) clamp(12px,3vw,24px) 40px}

/* ---------- Titolo e countdown ---------- */
header{text-align:center;margin-bottom:clamp(20px,4vw,36px)}
h1{
  font-family:"Lilita One","Arial Rounded MT Bold","Trebuchet MS",sans-serif;
  font-weight:400;
  font-size:clamp(2.1rem,8.2vw,4.4rem);
  line-height:1.02;margin:0 0 .35em;letter-spacing:.01em;
  text-shadow:0 3px 0 #0a2f73,0 6px 18px rgba(0,20,70,.45),0 0 28px rgba(255,211,77,.35);
}
.cd{display:inline-flex;flex-direction:column;align-items:center;gap:10px}
.cd-label{margin:0;font-weight:700;font-size:clamp(.95rem,2.8vw,1.1rem);opacity:.95}
.cd-units{display:flex;gap:clamp(6px,2vw,12px)}
.unit{
  min-width:clamp(62px,17vw,88px);padding:10px 6px 8px;border-radius:16px;
  background:var(--glass);border:1.5px solid var(--glass-line);
  backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
}
.unit b{display:block;font-family:"Lilita One","Trebuchet MS",sans-serif;font-weight:400;font-size:clamp(1.7rem,7vw,2.6rem);line-height:1;font-variant-numeric:tabular-nums;color:var(--gold)}
.unit span{display:block;font-size:.78rem;font-weight:700;margin-top:4px;opacity:.9}
.howto{margin:14px 0 0;font-size:.92rem;opacity:.85}

/* ---------- Griglia ---------- */
.grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:clamp(12px,2.2vw,20px)}
@media (max-width:720px){.grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media (max-width:500px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}

.box{
  position:relative;aspect-ratio:1;border-radius:14px;perspective:800px;
  user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent;
  box-shadow:0 10px 18px rgba(2,22,70,.35);
  outline:none;cursor:pointer;
}
.box:focus-visible{box-shadow:0 0 0 4px var(--gold),0 10px 18px rgba(2,22,70,.35)}
.inside{
  position:absolute;inset:0;border-radius:14px;overflow:hidden;background:#123;
  box-shadow:inset 0 0 0 3px rgba(0,0,0,.18),inset 0 10px 22px rgba(0,0,0,.35);
}
.inside svg{display:block;width:100%;height:100%}
.inside .badge{position:absolute;top:6px;left:6px;min-width:26px;height:26px;padding:0 6px;border-radius:13px;background:rgba(255,255,255,.92);color:#1b2a4a;font:400 .95rem/26px "Lilita One","Trebuchet MS",sans-serif;text-align:center;box-shadow:0 2px 6px rgba(0,0,0,.25)}

.door{
  position:absolute;top:0;bottom:0;width:50%;
  transition:transform 1s cubic-bezier(.25,1.35,.45,1),filter .3s;
  box-shadow:inset 0 0 0 2px rgba(255,255,255,.18),inset 0 -6px 12px rgba(0,0,0,.12);
}
.door.l{left:0;border-radius:14px 0 0 14px;transform-origin:left center;border-right:1px solid rgba(0,0,0,.25)}
.door.r{right:0;border-radius:0 14px 14px 0;transform-origin:right center}
.box.open .door.l{transform:rotateY(-108deg)}
.box.open .door.r{transform:rotateY(108deg)}
.box.instant .door{transition:none}

.dnum{
  position:absolute;top:8%;left:12%;
  font-family:"Lilita One","Trebuchet MS",sans-serif;font-size:clamp(1.5rem,4.6vw,2.5rem);line-height:1;color:#fff;
  text-shadow:0 2px 0 rgba(0,0,0,.25),0 3px 8px rgba(0,0,0,.25);
}
.dic{position:absolute;bottom:9%;right:12%;font-weight:800;font-size:clamp(.62rem,1.7vw,.85rem);color:#fff;opacity:.9;text-shadow:0 1px 2px rgba(0,0,0,.35)}
.lock{position:absolute;top:9%;right:11%;font-size:clamp(.8rem,2.2vw,1.1rem);filter:drop-shadow(0 1px 2px rgba(0,0,0,.35))}
.box.ready .lock,.box.open .lock{display:none}
.box.locked .door{filter:saturate(.7) brightness(.9)}

/* Scotch: metà sinistra sull’anta sinistra, metà destra sull’anta destra */
.tape{
  position:absolute;top:-3px;bottom:-3px;width:30%;
  background:
    linear-gradient(90deg,rgba(255,255,255,.35),rgba(255,255,255,0) 45%,rgba(255,255,255,.18)),
    repeating-linear-gradient(0deg,rgba(150,110,50,.10) 0 2px,transparent 2px 7px),
    rgba(226,200,142,.86);
  box-shadow:0 1px 3px rgba(0,0,0,.25);
  transition:transform .3s ease;
}
.door.l .tape{right:0;clip-path:polygon(0 3px,25% 0,50% 3px,75% 0,100% 2px,100% calc(100% - 2px),75% 100%,50% calc(100% - 3px),25% 100%,0 calc(100% - 3px))}
.door.r .tape{left:0;clip-path:polygon(0 2px,25% 0,50% 3px,75% 0,100% 3px,100% calc(100% - 3px),75% 100%,50% calc(100% - 3px),25% 100%,0 calc(100% - 2px))}
.box.cut .door.l .tape{transform:translateX(-2px)}
.box.cut .door.r .tape{transform:translateX(2px)}

.cutzone{position:absolute;top:0;bottom:0;left:30%;width:40%;z-index:3}
.box.ready .cutzone{cursor:crosshair;touch-action:none}
.box.open .cutzone{display:none}
.cutline{position:absolute;top:0;bottom:0;left:50%;width:3px;transform:translateX(-50%);display:flex;flex-direction:column}
.cutline i{flex:1;display:block}
.cutline i.on{background:repeating-linear-gradient(180deg,rgba(60,30,0,.8) 0 3px,transparent 3px 5px)}
.hint{display:none;position:absolute;top:-14px;left:50%;font-size:clamp(1.1rem,3vw,1.5rem);pointer-events:none;animation:hint 1.1s ease-in-out infinite;filter:drop-shadow(0 2px 3px rgba(0,0,0,.4))}
.box.ready .hint{display:block}
.box.cutting .hint{display:none}
.scissors{display:none;position:absolute;left:50%;top:0;font-size:1.8rem;pointer-events:none;transform:translate(-50%,-50%) rotate(90deg);filter:drop-shadow(0 2px 4px rgba(0,0,0,.45))}
.box.cutting .scissors{display:block}
@keyframes hint{0%,100%{transform:translateX(-50%) rotate(90deg) translateX(0)}50%{transform:translateX(-50%) rotate(90deg) translateX(8px)}}

.box.ready{animation:ready 2s ease-in-out infinite}
@keyframes ready{0%,100%{box-shadow:0 10px 18px rgba(2,22,70,.35),0 0 0 0 rgba(255,211,77,.0)}50%{box-shadow:0 10px 18px rgba(2,22,70,.35),0 0 0 6px rgba(255,211,77,.55)}}
.box.shake{animation:shake .45s ease}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-6px) rotate(-2deg)}40%{transform:translateX(6px) rotate(2deg)}60%{transform:translateX(-4px)}80%{transform:translateX(4px)}}

/* ---------- Toast, banner, footer ---------- */
#toast{
  position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:30;
  transform:translate(-50%,20px);opacity:0;pointer-events:none;
  background:rgba(8,30,80,.92);color:#fff;border:1.5px solid var(--glass-line);
  padding:12px 18px;border-radius:14px;font-weight:700;font-size:.95rem;max-width:min(92vw,460px);text-align:center;
  transition:opacity .25s,transform .25s;
}
#toast.show{opacity:1;transform:translate(-50%,0)}
.preview{margin:0 auto 18px;max-width:560px;text-align:center;background:rgba(255,211,77,.18);border:1.5px dashed var(--gold);border-radius:14px;padding:10px 14px;font-weight:700;font-size:.92rem}
.preview button{margin-left:8px;font:inherit;font-size:.85rem;padding:5px 12px;border-radius:999px;border:0;background:var(--gold);color:#1b2a4a;cursor:pointer}
footer{text-align:center;margin-top:30px;font-size:.88rem;opacity:.8;line-height:1.5}

/* ---------- Pulsante e accesso amministratore ---------- */
.admin-btn{
  position:fixed;z-index:20;top:calc(12px + env(safe-area-inset-top,0px));right:calc(12px + env(safe-area-inset-right,0px));
  font:700 .9rem/1 "Nunito","Trebuchet MS",sans-serif;color:#fff;cursor:pointer;
  padding:10px 14px;border-radius:999px;border:1.5px solid var(--glass-line);
  background:rgba(8,30,80,.55);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  box-shadow:0 4px 12px rgba(0,10,40,.3);
}
.admin-btn:hover{background:rgba(8,30,80,.75)}
.admin-btn:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.admin-btn.on{background:var(--gold);color:#1b2a4a;border-color:var(--gold)}
.login-card{width:min(100%,380px);padding:26px 22px 22px}
.login-card h2{margin-bottom:6px}
.login-card p.sub{margin:0 0 16px;text-align:center;color:var(--card-soft);font-size:.95rem}
.login-card label{display:block;font-weight:700;font-size:.9rem;margin-bottom:6px}
.login-card input{
  width:100%;font:500 1.05rem "Nunito","Trebuchet MS",sans-serif;padding:12px 14px;border-radius:12px;
  border:2px solid rgba(90,107,140,.35);background:transparent;color:var(--card-ink);
}
.login-card input:focus{outline:none;border-color:#3a86ff}
.login-err{min-height:1.3em;margin:8px 0 0;color:#e63946;font-weight:700;font-size:.9rem}
.login-card .enter{width:100%;margin-top:10px;padding:12px;border:0;border-radius:12px;background:#1d6fd6;color:#fff;font:800 1rem "Nunito","Trebuchet MS",sans-serif;cursor:pointer}
.login-card .enter:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.login-card.shake{animation:shake .45s ease}
@media (max-width:500px){.page{padding-top:64px}}

/* ---------- Finestra dell’indizio ---------- */
.modal{position:fixed;inset:0;z-index:40;display:flex;align-items:center;justify-content:center;padding:calc(16px + env(safe-area-inset-top,0px)) 16px calc(16px + env(safe-area-inset-bottom,0px))}
.modal[hidden]{display:none}
.backdrop{position:absolute;inset:0;background:rgba(3,18,55,.62);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
.card{
  position:relative;width:min(100%,520px);max-height:100%;overflow:auto;
  background:var(--card);color:var(--card-ink);border-radius:22px;padding:18px 18px 22px;
  box-shadow:0 24px 60px rgba(0,10,40,.5);animation:pop .45s cubic-bezier(.2,1.4,.4,1);
}
@keyframes pop{from{transform:scale(.85);opacity:0}to{transform:scale(1);opacity:1}}
.m-scene{width:min(100%,48vh);aspect-ratio:1;margin:0 auto;border-radius:16px;overflow:hidden;box-shadow:inset 0 0 0 3px rgba(0,0,0,.08)}
.m-scene svg{display:block;width:100%;height:100%}
.m-kicker{margin:16px 0 2px;font-weight:700;font-size:.9rem;color:var(--card-soft);text-align:center}
.card h2{margin:0 0 8px;font-family:"Lilita One","Trebuchet MS",sans-serif;font-weight:400;font-size:clamp(1.5rem,5vw,2rem);text-align:center;line-height:1.1}
.m-text{margin:0 auto;max-width:42ch;font-size:1.05rem;line-height:1.55;text-align:center}
.close{position:absolute;top:10px;right:10px;z-index:2;width:40px;height:40px;border-radius:50%;border:0;background:rgba(0,0,0,.55);color:#fff;font-size:1.5rem;line-height:1;cursor:pointer}
.close:focus-visible{outline:3px solid var(--gold);outline-offset:2px}

/* ---------- Animazioni delle scene ---------- */
.a-wave{transform-origin:0 0;animation:wave .6s ease-in-out infinite alternate}
.a-swing{transform-origin:0 0;animation:swing 2s ease-in-out infinite alternate}
.a-pulse{transform-box:fill-box;transform-origin:center;animation:pulse 1.6s ease-in-out infinite}
.a-twinkle{animation:twinkle 1.4s ease-in-out infinite}
.a-blink{animation:blink 1s steps(1) infinite}
.a-flicker{transform-box:fill-box;transform-origin:50% 100%;animation:flicker .22s ease-in-out infinite alternate}
.a-steam{animation:steam 2.4s ease-out infinite}
.a-waddle{transform-origin:0 0;animation:waddle .7s ease-in-out infinite alternate}
.a-slide{animation:slide 3.2s ease-in infinite}
.a-spin{transform-origin:0 0;animation:spin 9s linear infinite}
.a-spinfast{transform-origin:0 0;animation:spin .45s linear infinite}
.a-fall{animation:fall 3s linear infinite}
.a-blinkeye{transform-box:fill-box;transform-origin:center;animation:blinkeye 3.2s infinite}
.a-smoke{transform-box:fill-box;transform-origin:center;animation:smoke 3s ease-out infinite}
.a-train{animation:train 7s linear infinite}
.a-fly{animation:fly 8s linear infinite}
.a-chase{animation:chase 5s linear infinite}
.a-leg1{transform-origin:0 0;animation:legs .3s ease-in-out infinite alternate}
.a-leg2{transform-origin:0 0;animation:legs .3s ease-in-out infinite alternate-reverse}
.a-panic1{transform-origin:0 0;animation:panic .18s ease-in-out infinite alternate}
.a-panic2{transform-origin:0 0;animation:panic .18s ease-in-out infinite alternate-reverse}
.a-reach1{transform-origin:0 0;animation:reach .3s ease-in-out infinite alternate}
.a-reach2{transform-origin:0 0;animation:reach .3s ease-in-out infinite alternate-reverse}
.a-run{animation:runbob .15s ease-in-out infinite alternate}
.a-jump{animation:jump 1s cubic-bezier(.3,0,.4,1) infinite}
.a-lid{transform-box:fill-box;transform-origin:center;animation:lid 1.6s ease-in-out infinite}
.a-tb{animation:tb .25s ease-in-out infinite alternate}
.a-hat{transform-origin:0 0;animation:hat .3s ease-in-out infinite alternate}
@keyframes hat{from{transform:rotate(-6deg)}to{transform:rotate(5deg)}}
@keyframes wave{from{transform:rotate(-25deg)}to{transform:rotate(15deg)}}
@keyframes swing{from{transform:rotate(-14deg)}to{transform:rotate(14deg)}}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.1)}}
@keyframes twinkle{0%,100%{opacity:1}50%{opacity:.2}}
@keyframes blink{0%,49%{opacity:1}50%,100%{opacity:.25}}
@keyframes flicker{from{transform:scale(1,1)}to{transform:scale(.88,1.12)}}
@keyframes steam{0%{transform:translateY(6px);opacity:0}30%{opacity:.85}100%{transform:translateY(-24px);opacity:0}}
@keyframes waddle{from{transform:rotate(-8deg)}to{transform:rotate(8deg)}}
@keyframes slide{0%{transform:translate(0,0);opacity:0}10%{opacity:1}85%{opacity:1}100%{transform:translate(190px,104px);opacity:0}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes fall{0%{transform:translateY(0);opacity:0}15%{opacity:1}100%{transform:translateY(55px);opacity:0}}
@keyframes blinkeye{0%,92%,100%{transform:scaleY(1)}96%{transform:scaleY(.1)}}
@keyframes smoke{0%{transform:translate(0,0) scale(.6);opacity:.85}100%{transform:translate(-18px,-46px) scale(1.8);opacity:0}}
@keyframes train{from{transform:translateX(-80px)}to{transform:translateX(300px)}}
@keyframes fly{from{transform:translate(-150px,40px)}to{transform:translate(240px,-30px)}}
@keyframes chase{from{transform:translateX(-215px)}to{transform:translateX(240px)}}
@keyframes legs{from{transform:rotate(38deg)}to{transform:rotate(-38deg)}}
@keyframes panic{from{transform:rotate(140deg)}to{transform:rotate(215deg)}}
@keyframes reach{from{transform:rotate(-70deg)}to{transform:rotate(-108deg)}}
@keyframes runbob{from{transform:translateY(0)}to{transform:translateY(-4px)}}
@keyframes jump{0%,100%{transform:translateY(0)}50%{transform:translateY(-22px)}}
@keyframes lid{0%,55%,100%{transform:translate(0,0) rotate(0)}25%{transform:translate(0,-18px) rotate(-7deg)}}
@keyframes tb{from{transform:translateY(0)}to{transform:translateY(-5px)}}

@media (prefers-reduced-motion: reduce){
  .box.ready{animation:none;box-shadow:0 0 0 4px rgba(255,211,77,.7),0 10px 18px rgba(2,22,70,.35)}
  .hint{animation:none}
}
</style>
</head>
<body>
<div class="sky" aria-hidden="true"></div>
<canvas id="snow" aria-hidden="true"></canvas>
<button class="admin-btn" type="button" id="adminBtn">Amministratore</button>

<main class="page">
  <header>
    <h1>Il Calendario degli indizi</h1>
    <div class="cd" aria-live="polite">
      <p class="cd-label" id="cdLabel">Calcolo il tempo…</p>
      <div class="cd-units" id="cdUnits">
        <div class="unit"><b id="cdD">00</b><span>giorni</span></div>
        <div class="unit"><b id="cdH">00</b><span>ore</span></div>
        <div class="unit"><b id="cdM">00</b><span>minuti</span></div>
        <div class="unit"><b id="cdS">00</b><span>secondi</span></div>
      </div>
    </div>
    <p class="howto">Quando una scatola si illumina, trascina le forbici lungo lo scotch per tagliarlo.</p>
  </header>

  <div class="preview" id="preview" hidden>Modalità amministratore: tutte le scatole sono sbloccate per l’anteprima.<button type="button" id="resetBtn">Richiudi tutte</button></div>

  <section class="grid" id="grid" aria-label="Scatole indizio"></section>

  <footer>Ogni mattina alle 7:00, dal 1° al 25 dicembre, si sblocca una nuova scatola.</footer>
</main>

<div id="toast" role="status"></div>

<div class="modal" id="modal" hidden>
  <div class="backdrop" data-close></div>
  <div class="card" role="dialog" aria-modal="true" aria-labelledby="mTitle">
    <button class="close" type="button" data-close aria-label="Chiudi">×</button>
    <div class="m-scene" id="mScene"></div>
    <p class="m-kicker" id="mKicker"></p>
    <h2 id="mTitle"></h2>
    <p class="m-text" id="mText"></p>
  </div>
</div>

<div class="modal" id="login" hidden>
  <div class="backdrop" data-close-login></div>
  <form class="card login-card" id="loginForm" role="dialog" aria-modal="true" aria-labelledby="loginTitle" autocomplete="off">
    <button class="close" type="button" data-close-login aria-label="Chiudi">×</button>
    <h2 id="loginTitle">Area amministratore</h2>
    <p class="sub">Inserisci la password per vedere tutte le scatole già sbloccate.</p>
    <label for="pwd">Password</label>
    <input type="password" id="pwd" name="pwd" autocomplete="off" required>
    <p class="login-err" id="loginErr" role="alert"></p>
    <button class="enter" type="submit">Entra</button>
  </form>
</div>

<script>
/* =========================================================
   CONFIGURAZIONE — modifica qui titoli e testi degli indizi
   ========================================================= */
const CONFIG = {
  oraApertura: 7,          // ogni scatola si apre alle 7:00
  anno: null,              // null = anno in corso
  scatole: [
    { titolo: "Il pupazzo di neve",        indizio: "Primo indizio: scrivi qui il testo che vuoi svelare il 1° dicembre." },
    { titolo: "Il pacco misterioso",        indizio: "Secondo indizio: scrivi qui il testo del 2 dicembre." },
    { titolo: "La campana d’oro",           indizio: "Terzo indizio: scrivi qui il testo del 3 dicembre." },
    { titolo: "La stella cometa",           indizio: "Quarto indizio: scrivi qui il testo del 4 dicembre." },
    { titolo: "Il bastoncino di zucchero",  indizio: "Quinto indizio: scrivi qui il testo del 5 dicembre." },
    { titolo: "L’albero illuminato",        indizio: "Sesto indizio: scrivi qui il testo del 6 dicembre." },
    { titolo: "L’omino di pan di zenzero",  indizio: "Settimo indizio: scrivi qui il testo del 7 dicembre." },
    { titolo: "La pallina che dondola",     indizio: "Ottavo indizio: scrivi qui il testo dell’8 dicembre." },
    { titolo: "La candela accesa",          indizio: "Nono indizio: scrivi qui il testo del 9 dicembre." },
    { titolo: "La cioccolata calda",        indizio: "Decimo indizio: scrivi qui il testo del 10 dicembre." },
    { titolo: "La renna dal naso rosso",    indizio: "Undicesimo indizio: scrivi qui il testo dell’11 dicembre." },
