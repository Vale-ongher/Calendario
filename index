/* ---------- Ante delle scatole ---------- */
function doorBg(c, d){
  const shade = "linear-gradient(160deg,rgba(255,255,255,.2),rgba(0,0,0,.14))";
  switch(d % 5){
    case 0: return `radial-gradient(circle,rgba(255,255,255,.3) 22%,transparent 24%) 0 0/16px 16px,${shade},${c}`;
    case 1: return `repeating-linear-gradient(45deg,rgba(255,255,255,.2) 0 7px,transparent 7px 16px),${shade},${c}`;
    case 2: return `repeating-conic-gradient(rgba(255,255,255,.16) 0 25%,transparent 0 50%) 0 0/20px 20px,${shade},${c}`;
    case 3: return `repeating-linear-gradient(0deg,rgba(255,255,255,.22) 0 4px,transparent 4px 14px),${shade},${c}`;
    default: return `radial-gradient(circle at 25% 25%,rgba(255,255,255,.4) 2px,transparent 3px) 0 0/12px 12px,radial-gradient(circle at 75% 75%,rgba(255,255,255,.22) 3px,transparent 4px) 0 0/12px 12px,${shade},${c}`;
  }
}

function buildBox(d){
  const el = document.createElement("div");
  el.className = "box"; el.tabIndex = 0; el.setAttribute("role","button");
  const bg = doorBg(COLORS[d-1], d);
  el.innerHTML = `<div class="inside"></div>
    <div class="door l" style="background:${bg}"><span class="dnum">${d}</span><span class="tape"></span></div>
    <div class="door r" style="background:${bg}"><span class="lock" aria-hidden="true">🔒</span><span class="dic">dic</span><span class="tape"></span></div>
    <div class="cutzone"><div class="cutline">${"<i></i>".repeat(BINS)}</div><span class="hint" aria-hidden="true">✂️</span><span class="scissors" aria-hidden="true">✂️</span></div>`;
  const st = { d, el, bins:new Set(), cutting:false, last:null,
    cz: el.querySelector(".cutzone"), segs:[...el.querySelectorAll(".cutline i")], sc: el.querySelector(".scissors") };

  const canCut = () => !opened.has(d) && openable(d);
  function mark(e){
    const r = st.cz.getBoundingClientRect();
    const x = e.clientX - r.left, y = e.clientY - r.top;
    st.sc.style.left = x + "px"; st.sc.style.top = y + "px";
    if (x < -r.width * .7 || x > r.width * 1.7){ st.last = null; return; }
    let b = Math.floor(y / r.height * BINS); b = Math.max(0, Math.min(BINS - 1, b));
    const from = st.last === null ? b : st.last;
    for (let i = Math.min(from,b); i <= Math.max(from,b); i++){
      if (!st.bins.has(i)){ st.bins.add(i); st.segs[i].classList.add("on"); }
    }
    st.last = b;
    if (st.bins.size >= BINS - 3) finishCut(st);
  }
  st.cz.addEventListener("pointerdown", e => {
    if (!canCut()) return;
    st.cutting = true; st.last = null;
    try { st.cz.setPointerCapture(e.pointerId); } catch(_){}
    el.classList.add("cutting"); mark(e); e.preventDefault();
  });
  st.cz.addEventListener("pointermove", e => { if (st.cutting) mark(e); });
  ["pointerup","pointercancel","lostpointercapture"].forEach(t => st.cz.addEventListener(t, () => {
    st.cutting = false; st.last = null; el.classList.remove("cutting");
  }));

  el.addEventListener("click", () => {
    if (Date.now() - justCutAt < 1500) return;
    if (opened.has(d) && openable(d)) return openModal(d, el);
    if (!openable(d)) return lockedFeedback(st);
    if (st.bins.size === 0) toast("Trascina le forbici lungo lo scotch, dall’alto in basso ✂️");
  });
  el.addEventListener("keydown", e => {
    if (e.key !== "Enter" && e.key !== " ") return;
    e.preventDefault();
    if (opened.has(d) && openable(d)) return openModal(d, el);
    if (!openable(d)) return lockedFeedback(st);
    let i = 0;
    const iv = setInterval(() => {
      if (i >= BINS){ clearInterval(iv); finishCut(st); return; }
      st.bins.add(i); st.segs[i].classList.add("on"); i++;
    }, 30);
  });
  return st;
}

function finishCut(st){
  if (opened.has(st.d)) return;
  st.cutting = false; st.el.classList.remove("cutting");
  st.segs.forEach(s => s.classList.add("on"));
  opened.add(st.d); saveOpened();
  justCutAt = Date.now();
  st.el.classList.add("cut");
  setTimeout(() => refreshStates(), 280);
  setTimeout(() => openModal(st.d, st.el), 1300);
}

function lockedFeedback(st){
  st.el.classList.remove("shake"); void st.el.offsetWidth; st.el.classList.add("shake");
  toast(`🔒 La scatola ${st.d} si apre il ${st.d} dicembre alle 07:00. Ancora un po’ di pazienza!`);
}

function refreshStates(instant){
  boxes.forEach(st => {
    const { d, el } = st;
    const can = openable(d), isOpen = can && opened.has(d);
    el.setAttribute("aria-label", isOpen ? `Scatola ${d}, aperta: leggi l’indizio` : can ? `Scatola ${d}, pronta da aprire` : `Scatola ${d}, si apre il ${d} dicembre alle 7`);
    if (isOpen && !el.classList.contains("open")){
      el.querySelector(".inside").innerHTML = scene(d) + `<span class="badge">${d}</span>`;
      if (instant) el.classList.add("instant");
      el.classList.add("cut","open");
      if (instant) requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove("instant")));
    }
    if (!isOpen && el.classList.contains("open")){
      el.classList.remove("open","cut");
      el.querySelector(".inside").innerHTML = "";
    }
    if (!isOpen){
      st.bins.clear(); st.segs.forEach(s => s.classList.remove("on"));
    }
    el.classList.toggle("ready", can && !isOpen);
    el.classList.toggle("locked", !can);
  });
}

/* ---------- Countdown ---------- */
const cdLabel = document.getElementById("cdLabel"), cdUnits = document.getElementById("cdUnits");
function tick(){
  const now = Date.now();
  let next = null;
  for (let d = 1; d <= 25; d++){ if (unlockAt(d).getTime() > now){ next = d; break; } }
  if (next !== lastNext){ lastNext = next; refreshStates(); }
  if (next === null){
    cdLabel.textContent = "Tutte le scatole sono aperte. Buon Natale! 🎄";
    cdUnits.hidden = true; return;
  }
  cdUnits.hidden = false;
  cdLabel.textContent = next === 1
    ? "Manca questo tempo all’apertura della prima scatola"
    : `Manca questo tempo alla scatola ${next} (${next} dicembre, ore 07:00)`;
  let s = Math.floor((unlockAt(next).getTime() - now) / 1000);
  const dd = Math.floor(s / 86400); s -= dd * 86400;
  const hh = Math.floor(s / 3600); s -= hh * 3600;
  const mm = Math.floor(s / 60); s -= mm * 60;
  document.getElementById("cdD").textContent = pad(dd);
  document.getElementById("cdH").textContent = pad(hh);
  document.getElementById("cdM").textContent = pad(mm);
  document.getElementById("cdS").textContent = pad(s);
}

/* ---------- Finestra indizio ---------- */
const modal = document.getElementById("modal");
let returnFocus = null;
function openModal(d, from){
  const info = CONFIG.scatole[d-1];
  document.getElementById("mScene").innerHTML = scene(d);
  document.getElementById("mKicker").textContent = `Scatola ${d} · ${d} dicembre`;
  document.getElementById("mTitle").textContent = info.titolo;
  document.getElementById("mText").textContent = info.indizio;
  returnFocus = from || null;
  modal.hidden = false;
  document.body.style.overflow = "hidden";
  modal.querySelector(".close").focus();
}
function closeModal(){
  modal.hidden = true;
  document.getElementById("mScene").innerHTML = "";
  document.body.style.overflow = "";
  if (returnFocus) returnFocus.focus();
}
modal.addEventListener("click", e => { if (e.target.closest("[data-close]")) closeModal(); });
document.addEventListener("keydown", e => { if (e.key === "Escape" && !modal.hidden) closeModal(); });

/* ---------- Toast ---------- */
let toastT;
function toast(msg){
  const t = document.getElementById("toast");
  t.textContent = msg; t.classList.add("show");
  clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove("show"), 3200);
}

/* ---------- Modalità amministratore ---------- */
const adminBtn = document.getElementById("adminBtn");
const login = document.getElementById("login");
const pwd = document.getElementById("pwd");
const loginErr = document.getElementById("loginErr");
async function sha256(text){
  const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text));
  return [...new Uint8Array(buf)].map(b => b.toString(16).padStart(2, "0")).join("");
}
function setAdmin(on){
  preview = on;
  try { on ? sessionStorage.setItem("calendario-admin", "1") : sessionStorage.removeItem("calendario-admin"); } catch(e){}
  applyMode();
}
function openLogin(){
  pwd.value = ""; loginErr.textContent = "";
  login.hidden = false; document.body.style.overflow = "hidden";
  setTimeout(() => pwd.focus(), 50);
}
function closeLogin(){
  login.hidden = true; document.body.style.overflow = ""; adminBtn.focus();
}
adminBtn.addEventListener("click", () => {
  if (preview){ setAdmin(false); toast("Sei uscito dalla modalità amministratore."); }
  else openLogin();
});
login.addEventListener("click", e => { if (e.target.closest("[data-close-login]")) closeLogin(); });
document.addEventListener("keydown", e => { if (e.key === "Escape" && !login.hidden) closeLogin(); });
document.getElementById("loginForm").addEventListener("submit", async e => {
  e.preventDefault();
  let ok = false;
  try { ok = (await sha256(pwd.value.trim())) === ADMIN_HASH; } catch(err){ ok = false; }
  if (ok){
    closeLogin(); setAdmin(true);
    toast("Modalità amministratore attiva: tutte le scatole sono sbloccate.");
  } else {
    loginErr.textContent = "Password errata. Riprova.";
    const card = e.currentTarget; card.classList.remove("shake"); void card.offsetWidth; card.classList.add("shake");
    pwd.select();
  }
});

function applyMode(){
  document.getElementById("preview").hidden = !preview;
  adminBtn.textContent = preview ? "Esci da amministratore" : "Amministratore";
  adminBtn.classList.toggle("on", preview);
  opened = loadOpened();
  lastNext = undefined;
  refreshStates(true);
  tick();
}
document.getElementById("resetBtn").addEventListener("click", () => {
  opened = new Set(); saveOpened(); refreshStates(); toast("Scatole richiuse. Puoi provarle di nuovo.");
});

/* ---------- Neve ---------- */
(function snow(){
  const cv = document.getElementById("snow"), ctx = cv.getContext("2d");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let W = 0, H = 0, flakes = [];
  const make = init => {
    const r = Math.random() * 2.6 + .8;
    return { x: Math.random() * W, y: init ? Math.random() * H : -10, r, vy: (r * .35 + .3) * (reduce ? .35 : 1),
             sway: Math.random() * 1.5 + .3, ph: Math.random() * 6.28, o: Math.random() * .5 + .45 };
  };
  function resize(){
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = innerWidth; H = innerHeight;
    cv.width = W * dpr; cv.height = H * dpr; cv.style.width = W + "px"; cv.style.height = H + "px";
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const n = Math.max(30, Math.min(220, Math.round(W * H / (reduce ? 40000 : 9000))));
    while (flakes.length < n) flakes.push(make(true));
    flakes.length = n;
  }
  let t0 = performance.now();
  function frame(t){
    const dt = Math.min(50, t - t0) / 16.67; t0 = t;
    ctx.clearRect(0, 0, W, H); ctx.fillStyle = "#fff";
    for (const f of flakes){
      f.y += f.vy * dt; f.ph += .02 * dt; f.x += Math.sin(f.ph) * f.sway * .4 * dt;
      if (f.y > H + 10) Object.assign(f, make(false));
      if (f.x > W + 10) f.x = -10; else if (f.x < -10) f.x = W + 10;
      ctx.globalAlpha = f.o; ctx.beginPath(); ctx.arc(f.x, f.y, f.r, 0, 6.2832); ctx.fill();
    }
    ctx.globalAlpha = 1;
    requestAnimationFrame(frame);
  }
  addEventListener("resize", resize);
  resize(); requestAnimationFrame(frame);
})();

/* ---------- Avvio ---------- */
const grid = document.getElementById("grid");
for (let d = 1; d <= 25; d++){ const st = buildBox(d); boxes.push(st); grid.appendChild(st.el); }
applyMode();
setInterval(tick, 1000);
