/* ---------- Ante delle scatole ---------- */
function doorBg(c, d){
  const shade = "linear-gradient(160deg,rgba(255,255,255,.2),rgba(0,0,0,.14))";
  switch(d % 5){
    case 0: return `radial-gradient(circle,rgba(255,255,255,.3) 22%,transparent 24%) 0 0/16px 16px,${shade},${c}`;
    case 1: return `repeating-linear-gradient(45deg,rgba(255,255,255,.2) 0 7px,transparent 7px 16px),${shade},${c}`;
    case 2: return `repeating-conic-gradient(rgba(255,255,255,.16) 0 25%,transparent 0 50%) 0 0/20px 20px,${shade},${c}`;
    case 3: return `repeating-linear-gradient(0deg,rgba(255,255,255,.22) 0 4px,transparent 4px 14px),${shade},${c}`;
    default: return `radial-gradient(circle at 25% 25%,rgba(255,255,255,.4) 2px,transparent 3px) 0 0/12px 12px,radial-gradient(circle at 75% 75%,rgba(255,255,255,.22) 3px,transparent 4px) 0 0/12px 12px,${shade},${c}`;
  }
}

/* ---------- Tipo di apertura: taglia, tocca o scarta ---------- */
const TIPI = (() => {
  if (Array.isArray(CONFIG.aperture) && CONFIG.aperture.length === 25) return CONFIG.aperture;
  /* Mix casuale ma equilibrato: mai due prove uguali una accanto all’altra,
     mai uguali sulla stessa colonna e al massimo 2 uguali per fila. */
  const K = ["taglia","tocca","scarta"], quota = { taglia:9, tocca:8, scarta:8 }, r = rand(YEAR + 7), a = [];
  const fits = (i, t) => quota[t] > 0 && [1,5].every(o => i < o || a[i-o] !== t) &&
    a.slice(i - i % 5, i).filter(x => x === t).length < 2;
  const go = i => {
    if (i === 25) return true;
    const order = K.slice();
    for (let k = 2; k > 0; k--){ const j = Math.floor(r() * (k + 1)); [order[k], order[j]] = [order[j], order[k]]; }
    for (const t of order){
      if (!fits(i, t)) continue;
      a[i] = t; quota[t]--;
      if (go(i + 1)) return true;
      quota[t]++; a.length = i;
    }
    return false;
  };
  return go(0) ? a : Array.from({ length:25 }, (_, i) => K[i % 3]);
})();
const HINT = { taglia:"✂️", tocca:"👆", scarta:"🎁" };
const INSTR = {
  taglia: "Taglia lo scotch: scorri il dito lungo la striscia orizzontale e lungo quella verticale.",
  tocca:  "Tocca la scatola 3 volte per rompere il sigillo.",
  scarta: "Scarta il regalo: strofina il dito sulla carta per strapparla."
};
const PAPERS = [
  { p:"#c1121f", r:"#ffd34d" }, { p:"#14532d", r:"#ff6b6b" }, { p:"#1e3a8a", r:"#f1f5f9" },
  { p:"#6d28d9", r:"#ffd34d" }, { p:"#0f766e", r:"#ffc2d1" }, { p:"#b45309", r:"#ffffff" }
];
const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

function sealSVG(){
  let p = "";
  for (let i = 0; i <= 72; i++){ const a = i / 72 * Math.PI * 2, r = 44 + 3 * Math.sin(a * 14); p += (i ? "L" : "M") + (50 + Math.cos(a) * r).toFixed(1) + " " + (50 + Math.sin(a) * r).toFixed(1); }
  return `<svg viewBox="0 0 100 100" aria-hidden="true"><path d="${p}Z" fill="#c1121f" stroke="#8d0c18" stroke-width="2"/>
    <circle cx="50" cy="50" r="31" fill="#ad0f1b" stroke="rgba(255,255,255,.22)" stroke-width="2"/>${star(50,51,19,"#e04556")}
    <path d="M36 28 Q44 22 54 24" stroke="rgba(255,255,255,.4)" stroke-width="3" fill="none" stroke-linecap="round"/>
    <path class="crack c1" d="M50 50 L42 34 L46 24 L40 8" stroke="#3a0006" stroke-width="2.6" fill="none" stroke-linejoin="round"/>
    <path class="crack c2" d="M50 50 L66 58 L74 54 L92 62 M50 50 L46 68 L54 78 L50 93" stroke="#3a0006" stroke-width="2.6" fill="none" stroke-linejoin="round"/></svg>`;
}
const bowSVG = c => `<svg viewBox="0 0 100 70" aria-hidden="true">
  <path d="M46 40 L34 68 L43 63 L50 44Z M54 40 L66 68 L57 63 L50 44Z" fill="${c}" stroke="rgba(0,0,0,.25)" stroke-width="1.5"/>
  <path d="M50 36 C30 4 2 10 9 32 C14 48 36 44 50 36Z" fill="${c}" stroke="rgba(0,0,0,.25)" stroke-width="1.5"/>
  <path d="M50 36 C70 4 98 10 91 32 C86 48 64 44 50 36Z" fill="${c}" stroke="rgba(0,0,0,.25)" stroke-width="1.5"/>
  <circle cx="50" cy="37" r="8" fill="${c}" stroke="rgba(0,0,0,.3)" stroke-width="1.5"/>
  <path d="M22 22 Q30 17 39 27 M78 22 Q70 17 61 27" stroke="rgba(255,255,255,.5)" stroke-width="3" fill="none" stroke-linecap="round"/></svg>`;

function faceHTML(d, big){
  const tipo = TIPI[d-1], bg = doorBg(COLORS[d-1], d);
  let cover = "";
  if (tipo === "taglia"){
    cover = `<div class="tape tape-h"><i class="half a"></i><i class="half b"></i>${big ? `<div class="cutrow">${"<i></i>".repeat(BINS)}</div>` : ""}</div>
             <div class="tape tape-v"><i class="half a"></i><i class="half b"></i>${big ? `<div class="cutcol">${"<i></i>".repeat(BINS)}</div>` : ""}</div>`;
  } else if (tipo === "tocca"){
    cover = `<div class="seal">${sealSVG()}</div>`;
  } else {
    const pp = PAPERS[d % PAPERS.length];
    let pieces = "";
    if (big){ for (let r = 0; r < 5; r++) for (let c = 0; c < 5; c++) pieces += `<i style="--px:${c*25}%;--py:${r*25}%"></i>`; }
    else pieces = "<i></i>";
    cover = `<div class="paper${big ? "" : " whole"}" style="--paper:${pp.p};--rib:${pp.r}">${pieces}</div><div class="bow">${bowSVG(pp.r)}</div>`;
  }
  return `<div class="inside"></div>
    <div class="door l" style="background:${bg}"></div><div class="door r" style="background:${bg}"></div>
    <div class="cover">${cover}</div>
    <span class="dnum">${d}</span><span class="lock" aria-hidden="true">🔒</span><span class="dic">dic</span>
    <span class="hint" aria-hidden="true">${HINT[tipo]}</span>`;
}

function buildBox(d){
  const el = document.createElement("div");
  el.className = "box t-" + TIPI[d-1]; el.tabIndex = 0; el.setAttribute("role","button");
  el.innerHTML = faceHTML(d, false);
  const st = { d, el };
  const act = () => {
    if (opened.has(d) && openable(d)) return openModal(d, el);
    if (!openable(d)) return lockedFeedback(st);
    openZoom(d, el);
  };
  el.addEventListener("click", act);
  el.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " "){ e.preventDefault(); act(); } });
  return st;
}

function lockedFeedback(st){
  st.el.classList.remove("shake"); void st.el.offsetWidth; st.el.classList.add("shake");
  toast(`🔒 La scatola ${st.d} si apre il ${st.d} dicembre alle 07:00. Ancora un po’ di pazienza!`);
}

function refreshStates(instant){
  boxes.forEach(({ d, el }) => {
    const can = openable(d), isOpen = can && opened.has(d);
    el.setAttribute("aria-label", isOpen ? `Scatola ${d}, aperta: leggi l’indizio` : can ? `Scatola ${d}, pronta da aprire` : `Scatola ${d}, si apre il ${d} dicembre alle 7`);
    if (isOpen && !el.classList.contains("open")){
      el.querySelector(".inside").innerHTML = scene(d) + `<span class="badge">${d}</span>`;
      if (instant) el.classList.add("instant");
      el.classList.add("open");
      if (instant) requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove("instant")));
    }
    if (!isOpen && el.classList.contains("open")){
      el.classList.remove("open");
      el.querySelector(".inside").innerHTML = "";
    }
    el.classList.toggle("ready", can && !isOpen);
    el.classList.toggle("locked", !can);
  });
}

/* ---------- Scatola ingrandita e prove di apertura ---------- */
const zoom = document.getElementById("zoom"), zwrap = document.getElementById("zwrap");
const zinstr = document.getElementById("zinstr"), zprog = document.getElementById("zprog");
let Z = null;

function openZoom(d, from){
  const tipo = TIPI[d-1];
  zwrap.innerHTML = "";
  const zb = document.createElement("div");
  zb.className = "box zbox t-" + tipo; zb.tabIndex = 0;
  zb.setAttribute("role","button"); zb.setAttribute("aria-label", `Scatola ${d}. ${INSTR[tipo]}`);
  zb.innerHTML = faceHTML(d, true);
  zwrap.appendChild(zb);
  zinstr.textContent = INSTR[tipo];
  Z = { d, tipo, zb, from, done:false, down:false,
        h:new Set(), v:new Set(), lastH:null, lastV:null, hDone:false, vDone:false,
        segsH:[...zb.querySelectorAll(".cutrow i")], segsV:[...zb.querySelectorAll(".cutcol i")],
        taps:0, torn:new Set(), last:null, pieces:[...zb.querySelectorAll(".paper i")] };
  renderProg();
  zoom.hidden = false; document.body.style.overflow = "hidden";
  if (!reduceMotion){
    const a = from.getBoundingClientRect(), b = zb.getBoundingClientRect();
    const s = a.width / b.width, dx = (a.left + a.width/2) - (b.left + b.width/2), dy = (a.top + a.height/2) - (b.top + b.height/2);
    zb.animate([{ transform:`translate(${dx}px,${dy}px) scale(${s})` }, { transform:"none" }], { duration:480, easing:"cubic-bezier(.2,1.1,.35,1)" });
    zoom.querySelector(".zbackdrop").animate([{ opacity:0 }, { opacity:1 }], { duration:300 });
  }
  bindZoom(zb);
  setTimeout(() => zb.focus({ preventScroll:true }), 60);
}

function closeZoom(restore){
  const from = Z && Z.from;
  zoom.hidden = true; zwrap.innerHTML = ""; Z = null;
  document.body.style.overflow = "";
  if (restore && from) from.focus();
}
zoom.addEventListener("click", e => { if (e.target.closest("[data-zclose]")) closeZoom(true); });
document.addEventListener("keydown", e => { if (e.key === "Escape" && !zoom.hidden) closeZoom(true); });

function bindZoom(zb){
  zb.addEventListener("pointerdown", e => {
    if (!Z || Z.done) return;
    e.preventDefault();
    if (Z.tipo === "tocca"){ const r = zb.getBoundingClientRect(); tap(e.clientX - r.left, e.clientY - r.top); return; }
    Z.down = true; Z.lastH = Z.lastV = null; Z.last = null;
    try { zb.setPointerCapture(e.pointerId); } catch(_){}
    move(e);
  });
  zb.addEventListener("pointermove", e => { if (Z && Z.down && !Z.done) move(e); });
  ["pointerup","pointercancel","lostpointercapture"].forEach(t => zb.addEventListener(t, () => {
    if (!Z) return; Z.down = false; Z.lastH = Z.lastV = null; Z.last = null;
  }));
  zb.addEventListener("keydown", e => {
    if (!Z || Z.done || (e.key !== "Enter" && e.key !== " ")) return;
    e.preventDefault();
    if (Z.tipo === "tocca"){ const r = zb.getBoundingClientRect(); tap(r.width/2, r.height/2); }
    else if (Z.tipo === "taglia"){ cutTape(Z.hDone ? "v" : "h"); }
    else { const left = Z.pieces.map((_, i) => i).filter(i => !Z.torn.has(i)); left.sort(() => Math.random() - .5).slice(0, 5).forEach(tear); checkTear(); }
  });
}

function move(e){
  const r = Z.zb.getBoundingClientRect();
  const u = (e.clientX - r.left) / r.width, v = (e.clientY - r.top) / r.height;
  if (Z.tipo === "taglia") cutMove(u, v); else tearMove(u, v);
}

/* Taglio: striscia orizzontale e verticale */
function fillBins(set, segs, from, to){
  for (let i = Math.min(from, to); i <= Math.max(from, to); i++){ if (!set.has(i)){ set.add(i); segs[i].classList.add("on"); } }
}
function cutMove(u, v){
  const band = .17, bin = x => Math.max(0, Math.min(BINS - 1, Math.floor(x * BINS)));
  if (!Z.hDone && Math.abs(v - .5) < band){
    const b = bin(u); fillBins(Z.h, Z.segsH, Z.lastH === null ? b : Z.lastH, b); Z.lastH = b;
    if (Z.h.size >= BINS - 3) cutTape("h");
  } else Z.lastH = null;
  if (Z && !Z.vDone && Math.abs(u - .5) < band){
    const b = bin(v); fillBins(Z.v, Z.segsV, Z.lastV === null ? b : Z.lastV, b); Z.lastV = b;
    if (Z.v.size >= BINS - 3) cutTape("v");
  } else if (Z) Z.lastV = null;
}
function cutTape(k){
  if (!Z || Z[k + "Done"]) return;
  Z[k + "Done"] = true;
  const segs = k === "h" ? Z.segsH : Z.segsV;
  segs.forEach(s => s.classList.add("on"));
  const tape = Z.zb.querySelector(k === "h" ? ".tape-h" : ".tape-v");
  setTimeout(() => tape.classList.add("cut"), 150);
  renderProg();
  if (Z.hDone && Z.vDone) complete(650);
}

/* Tre tocchi sul sigillo */
function tap(x, y){
  Z.taps++;
  sparks(x, y, Z.taps === 3 ? 14 : 7);
  const zb = Z.zb, seal = zb.querySelector(".seal");
  zb.classList.remove("squash"); void zb.offsetWidth; zb.classList.add("squash");
  if (Z.taps === 1) seal.classList.add("lv1");
  if (Z.taps === 2) seal.classList.add("lv2");
  renderProg();
  if (Z.taps >= 3){ seal.classList.add("broken"); complete(450); }
}
function sparks(x, y, n){
  for (let i = 0; i < n; i++){
    const s = document.createElement("span"); s.className = "spark"; s.textContent = "✦";
    const a = Math.random() * 6.283, dist = 30 + Math.random() * 50;
    s.style.left = x + "px"; s.style.top = y + "px";
    s.style.setProperty("--sx", (Math.cos(a) * dist).toFixed(0) + "px");
    s.style.setProperty("--sy", (Math.sin(a) * dist).toFixed(0) + "px");
    Z.zb.appendChild(s); setTimeout(() => s.remove(), 650);
  }
}

/* Carta da scartare */
function tearMove(u, v){
  const pts = [];
  if (Z.last){
    const [lu, lv] = Z.last, steps = Math.max(1, Math.ceil(Math.hypot(u - lu, v - lv) / .04));
    for (let i = 1; i <= steps; i++) pts.push([lu + (u - lu) * i / steps, lv + (v - lv) * i / steps]);
  } else pts.push([u, v]);
  Z.last = [u, v];
  const R = .07; /* il dito strappa un po’ di carta tutto intorno */
  for (const [pu, pv] of pts){
    for (const [ou, ov] of [[0,0],[-R,0],[R,0],[0,-R],[0,R]]){
      const x = pu + ou, y = pv + ov;
      if (x < 0 || x >= 1 || y < 0 || y >= 1) continue;
      tear(Math.floor(y * 5) * 5 + Math.floor(x * 5));
    }
  }
  checkTear();
}
function tear(i){
  if (!Z || Z.torn.has(i)) return;
  Z.torn.add(i);
  const c = i % 5 - 2, r = Math.floor(i / 5) - 2, p = Z.pieces[i];
  p.style.setProperty("--tx", (c * 45 + (Math.random() * 60 - 30)).toFixed(0) + "px");
  p.style.setProperty("--ty", (r * 45 + 40 + Math.random() * 60).toFixed(0) + "px");
  p.style.setProperty("--rot", (Math.random() * 240 - 120).toFixed(0) + "deg");
  p.classList.add("torn");
  const bow = Z.zb.querySelector(".bow"); if (bow) bow.classList.add("gone");
  renderProg();
}
function checkTear(){
  if (!Z || Z.done || Z.torn.size < 19) return;
  Z.pieces.forEach((_, i) => { if (!Z.torn.has(i)) setTimeout(() => tear(i), Math.random() * 250); });
  complete(700);
}

function renderProg(){
  if (!Z) return;
  if (Z.tipo === "taglia"){
    zprog.innerHTML = `<span class="${Z.hDone ? "done" : ""}">${Z.hDone ? "✓ " : ""}Orizzontale</span><span class="${Z.vDone ? "done" : ""}">${Z.vDone ? "✓ " : ""}Verticale</span>`;
  } else if (Z.tipo === "tocca"){
    zprog.innerHTML = [1,2,3].map(i => `<span class="${Z.taps >= i ? "done" : ""}">${i}</span>`).join("");
  } else {
    const pct = Math.min(100, Math.round(Z.torn.size / 25 * 100));
    zprog.innerHTML = `<span class="${pct >= 76 ? "done" : ""}">Carta strappata: ${pct}%</span>`;
  }
}

function complete(delay){
  if (!Z || Z.done) return;
  Z.done = true;
  const { d, zb, from } = Z;
  opened.add(d); saveOpened(); justCutAt = Date.now();
  zinstr.textContent = "Ben fatto! La scatola si sta aprendo…";
  setTimeout(() => { if (zb.isConnected){ zb.querySelector(".inside").innerHTML = scene(d); zb.classList.add("open"); } }, delay);
  setTimeout(() => {
    refreshStates();
    if (Z && Z.d === d && !zoom.hidden){ closeZoom(false); openModal(d, from); }
  }, delay + 1300);
}

/* ---------- Countdown ---------- */
const cdLabel = document.getElementById("cdLabel"), cdUnits = document.getElementById("cdUnits");
function tick(){
  const now = Date.now();
  let next = null;
  for (let d = 1; d <= 25; d++){ if (unlockAt(d).getTime() > now){ next = d; break; } }
  if (next !== lastNext){ lastNext = next; refreshStates(); }
  if (next === null){
    cdLabel.textContent = "Tutte le scatole sono aperte. Buon Natale! 🎄";
    cdUnits.hidden = true; return;
  }
  cdUnits.hidden = false;
  cdLabel.textContent = next === 1
    ? "Manca questo tempo all’apertura della prima scatola"
    : `Manca questo tempo alla scatola ${next} (${next} dicembre, ore 07:00)`;
  let s = Math.floor((unlockAt(next).getTime() - now) / 1000);
  const dd = Math.floor(s / 86400); s -= dd * 86400;
  const hh = Math.floor(s / 3600); s -= hh * 3600;
  const mm = Math.floor(s / 60); s -= mm * 60;
  document.getElementById("cdD").textContent = pad(dd);
  document.getElementById("cdH").textContent = pad(hh);
  document.getElementById("cdM").textContent = pad(mm);
  document.getElementById("cdS").textContent = pad(s);
}

