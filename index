/* ---------- Disegni ---------- */
function rand(seed){ let s = seed * 9301 + 49297; return () => (s = (s * 9301 + 49297) % 233280) / 233280; }
function star(cx, cy, R, fill, cls = "", delay = 0){
  const p = [];
  for (let i = 0; i < 10; i++){
    const a = -Math.PI / 2 + i * Math.PI / 5, rr = i % 2 ? R * .45 : R;
    p.push((cx + Math.cos(a) * rr).toFixed(1) + "," + (cy + Math.sin(a) * rr).toFixed(1));
  }
  return `<polygon points="${p.join(" ")}" fill="${fill}" class="${cls}" style="animation-delay:${delay}s"/>`;
}
function skyStars(seed, n, maxY = 120, color = "#fff"){
  const r = rand(seed); let s = "";
  for (let i = 0; i < n; i++) s += `<circle cx="${(r()*200).toFixed(0)}" cy="${(r()*maxY).toFixed(0)}" r="${(r()*1.6+.6).toFixed(1)}" fill="${color}" class="a-twinkle" style="animation-delay:${(r()*1.4).toFixed(2)}s"/>`;
  return s;
}
